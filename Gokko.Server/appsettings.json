{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Caddy の後ろで動かすので、自分のPCの中（127.0.0.1）だけで待ち受ける
  "Urls": "http://127.0.0.1:5000",

  "Gokko": {
    // 合言葉と管理キーは、ここに書かずに環境変数（Gokko__Password / Gokko__AdminKey）で渡すのがおすすめ
    "Password": "",
    "AdminKey": "",
    "DataDirectory": "Data",
    "BroadcastIntervalMs": 500,

    "Random": {
      "Enabled": false,
      "RollIntervalSeconds": 47,
      "Probability": 0.1,
      "AutoReleaseSeconds": 360,
      "MaxConcurrent": 1,
      "AvoidRepeat": true,
      "SectionsAhead": 1,
      "SectionsBehind": 0,
      "FallbackToAllCrossings": false
    }
  }
}
