        // 始発の入換: 10・11・12番線から 13番線へ（上りで出区する列車。先に入換で13番線に入ってから出発）
        "shunt": [
          { "from": 10, "to": 13, "routes": ["11R"] }, { "from": 11, "to": 13, "routes": ["15L13"] }, { "from": 12, "to": 13, "routes": ["16L13"] }
