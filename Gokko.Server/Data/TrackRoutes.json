        "shuntOut": [ { "from": 1, "label": "5番線（引上線）", "routes": ["23R"] }, { "from": 2, "label": "5番線（引上線）", "routes": ["24R"] } ]
      },
      "notes": [
        "下りは場内が2段（10LC/10LD で 34T まで、4L/5L で番線へ）",
        "上りの3・4番線発（6R/7R）は、下りで着いた列車の折り返し",
        "1・2番線から5番線（引上線）への入換（23R/24R）、5番線から3・4番線（25LC/25LD）は表に入れていない"
      ]
    },
    {
      "id": "TH66S", "name": "江ノ原信号場", "interlock": "江ノ原信号場連動装置",
      "down": {
        "through": ["5LE"],
        "arrive": [ { "track": 10, "routes": ["5LD"], "turnback": true, "note": "江ノ原検車区へ入区。この先へは進めない" } ],
