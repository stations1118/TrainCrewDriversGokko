// 番線の表（案）。駅・方向・番線ごとに、TRAIN CREW に送る進路の並びを書く。
//
// 方向: 下り = 新大路方 → 館浜方、上り = 館浜方 → 新大路方
// arrive  … 本線からその番線に入る進路（場内）。並びは本線側から順。2本あるもの（第二場内など）は両方送る
// depart  … その番線から本線へ出る進路（出発）。並びは番線側から順
// through … 番線を使わずに通過する進路（江ノ原信号場の本線）
// shunt   … 始発の入換（from 番線 → to 番線）。from にいる列車は、まず入換で to に入り、それから出発する
// departStop … arrive に付ける。出発停止の番線（場内進路を開通させている間は、出発を開通できない）。
//              連動表の場内進路の鎖錠欄に、同じ番線から同じ方向への出発があるもの。入換（shunt）は書かなくても常に出発停止
// turnback   … arrive に付ける。行き止まり（折り返し）として選べる番線。選ぶと列車はその駅で打ち切り、先の駅は扱わない
//              （ダイヤグラムの線もその駅で切る）
// shuntOut … 終着の列車の入換（from 番線 → label の線路。引上線・検車区など）。番線に入りきった列車が「入換要求」で使う。
//              同じ番線に複数あれば、最初が列車のボタンの既定。ほかは管理画面の駅扱いから選ぶ
// 送る順番（出発→場内 など）は、サーバーの側で決める。ここには「どの進路が必要か」だけを書く。
{
  "stations": [
    {
      "id": "TH76", "name": "館浜", "interlock": "館浜連動装置",
      "down": {
        "arrive": [
          { "track": 1, "routes": ["5LA"] }, { "track": 2, "routes": ["5LB"] },
          { "track": 3, "routes": ["5LC"] }, { "track": 4, "routes": ["5LD"] }
        ],
        "depart": []
      },
      "up": {
        "arrive": [],
        "depart": [
          { "track": 1, "routes": ["1R"] }, { "track": 2, "routes": ["2R"] },
          { "track": 3, "routes": ["3R"] }, { "track": 4, "routes": ["4R"] }
        ]
      },
      "notes": ["終着駅。下りは着くだけ、上りは出るだけ"]
    },
    {
      "id": "TH75", "name": "駒野", "interlock": "駒野連動装置",
      "down": {
        "arrive": [
          // 1・2番線は行き止まり（館浜方へは出られない）。選ぶと駒野で打ち切り（折り返し）
          { "track": 1, "routes": ["9LA"], "turnback": true }, { "track": 2, "routes": ["9LB"], "turnback": true }, { "track": 3, "routes": ["9LC"] }
        ],
        "depart": [
          { "track": 3, "routes": ["6L", "2L"] },
          { "track": 5, "routes": ["3L"] }, { "track": 6, "routes": ["4L"] }
        ]
      },
      "up": {
        "arrive": [
          // 1番線は出発停止（場内 5RA を先に開通させ、列車が入りきるまで 7R を出さない）
          { "track": 1, "routes": ["1RE", "5RA"], "departStop": true }, { "track": 2, "routes": ["1RE", "5RB"] },
          { "track": 5, "routes": ["1RD5"] }, { "track": 6, "routes": ["1RD6"] }
        ],
        "depart": [
          { "track": 1, "routes": ["7R"] }, { "track": 2, "routes": ["8R"] }
        ],
        // 始発の入換: 4・5・6番線から1番線へ（そのあと 7R で出発）
        "shunt": [ { "from": 4, "to": 1, "routes": ["24R"] }, { "from": 5, "to": 1, "routes": ["25R"] }, { "from": 6, "to": 1, "routes": ["26R"] } ]
      },
      "notes": [
        "下りが通れるのは3番線だけ（6L で 6LT まで出て、第二出発 2L で本線へ）",
        "上りが通れるのは1・2番線だけ（1RE で 1RET まで入り、5RA/5RB で番線へ）",
        "下り1・2番線と上り5・6番線は、着いたら折り返す（そのまま同じ方向には出られない）"
      ]
    },
