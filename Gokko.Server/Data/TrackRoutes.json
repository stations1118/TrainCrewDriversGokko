          { "track": 1, "routes": ["9LA"], "turnback": true }, { "track": 2, "routes": ["9LB"], "turnback": true }, { "track": 3, "routes": ["9LC"] }
        ],
        "depart": [
          { "track": 3, "routes": ["6L", "2L"] },
          { "track": 5, "routes": ["3L"] }, { "track": 6, "routes": ["4L"] }
        ]
      },
      "up": {
        "arrive": [
          { "track": 1, "routes": ["1RE", "5RA"] }, { "track": 2, "routes": ["1RE", "5RB"] },
          { "track": 5, "routes": ["1RD5"] }, { "track": 6, "routes": ["1RD6"] }
        ],
        "depart": [
          { "track": 1, "routes": ["7R"] }, { "track": 2, "routes": ["8R"] }
        ]
      },
      "notes": [
        "下りが通れるのは3番線だけ（6L で 6LT まで出て、第二出発 2L で本線へ）",
        "上りが通れるのは1・2番線だけ（1RE で 1RET まで入り、5RA/5RB で番線へ）",
        "下り1・2番線と上り5・6番線は、着いたら折り返す（そのまま同じ方向には出られない）"
