// 進路の決まり
{
  // 単線区間（隣り合う「進路を扱う駅」どうし。間に連動装置のない駅があってもよい）。交換の判断はここだけで行う
  // 単線: 大道寺〜藤江〜水越〜高見沢〜日野森、西赤山〜赤山町。複線: 館浜〜大道寺、日野森〜西赤山
  "singleTrackSections": [
    ["TH65", "TH64"], ["TH64", "TH63"], ["TH63", "TH62"], ["TH62", "TH61"],
    ["TH59", "TH58"]
  ],

  // 所定の番線（ダイヤ Timetable.json にない列車、またはダイヤに番線が書かれていない駅で使う）。
  // キーは「終着:種別」「始発:種別」「終着」「始発」「種別」「*」の順に探す。
  // 駅・方向が書かれていなければ、TrackRoutes.json の最初の「そのまま通れる番線」を使う。江ノ原信号場は通過。
  "defaultTracks": {
    "TH76":  { "下り": { "*": 3, "特急": 1, "快急": 2, "普通": 4 },
               "上り": { "*": 3, "特急": 1, "快急": 2, "急行": 2, "普通": 4 } },
    "TH75":  { "下り": { "*": 3 }, "上り": { "*": 2 } },
    "TH71":  { "下り": { "*": 3 }, "上り": { "*": 2 } },
    "TH70":  { "下り": { "*": 2 }, "上り": { "*": 1 } },
    "TH67":  { "下り": { "*": 3, "始発:普通": 4 }, "上り": { "*": 2, "終着:普通": 1 } },
    "TH66S": { "下り": { "終着": 10 }, "上り": { "終着": 11, "始発": 13 } },
    "TH65":  { "下り": { "*": 4, "終着:普通": 3 }, "上り": { "*": 1, "終着:準急": 2 } },
    // 上り特急: 藤江2・水越2・高見沢1
    "TH64":  { "下り": { "*": 2 }, "上り": { "*": 2, "特急": 2 } },
    "TH63":  { "下り": { "*": 1 }, "上り": { "*": 1, "特急": 2 } },
    "TH62":  { "下り": { "*": 1 }, "上り": { "*": 2, "特急": 1 } },
    "TH61":  { "下り": { "*": 3 }, "上り": { "*": 2 } },
    "TH59":  { "下り": { "*": 2 }, "上り": { "*": 1 } },
    "TH58":  { "下り": { "*": 3 }, "上り": { "*": 1 } }
  },

  // 種別の強さ（弱い順）。待避では、自分より強い種別の後続列車に追いつかれる見込みなら待つ
  "typeRank": ["回送", "普通", "準急", "区急", "急行", "快急", "特急"],

  // 待避する駅と待避の番線。どの種別も、自分より強い列車を待つ
  "passingStations": [
    { "station": "TH71", "下り": 4, "上り": 1 },
    { "station": "TH67", "下り": 4, "上り": 1 }
  ],

  // 1回の待避で待つ列車の最大本数
  "maxPassingWaits": 3,

  // 待避の余裕時分（秒）と許容の遅れ（秒）。管理画面で変えられる
  "passingMarginSeconds": 120,
  "passingToleranceSeconds": 60,

  // 標準の停車時分（秒）
  "defaultDwellSeconds": 20,
  // 待避線（passingStations の番線）での停車時分の見込み（秒）。ダイヤグラムの見込みと待避の判断に使う。
  // 出発の開通は秒数ではなく、番線に入りきって止まった（ゲームの速度が 0km/h）ことを確かめてから
  "minLoopDwellSeconds": 90,
  // 止まった（0km/h）のを確かめてから、出発・入換を開通させるまでの上乗せ秒数。
  // 待避線・出発信号が停止のまま入った番線・下の departDelaySeconds の番線・終着の入換に使う
  "afterStopSeconds": 0,

  // 必ず止まってから出発を開通させる番線（駅 → 方向 → 番線）と、止まってからの上乗せ秒数。
  // 待っている間も、単線区間の交換（相手の駅の対向列車・対向の出発進路）は判断する
  "departDelaySeconds": {
    "TH65": { "上り": { "1": 0 } }
  }
}
